generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  RATE_LIMITED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String?
  avatar        String?
  googleId      String         @unique
  slackToken    String?
  slackChannel  String?
  senderConfigs SenderConfig[]
  emails        EmailJob[]
  createdAt     DateTime       @default(now())
}

model SenderConfig {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderEmail String     @unique
  hourlyLimit Int        @default(200)
  emails      EmailJob[]
  createdAt   DateTime   @default(now())
}

model EmailJob {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderConfigId String
  senderConfig   SenderConfig @relation(fields: [senderConfigId], references: [id], onDelete: Cascade)
  recipientEmail String
  subject        String
  body           String
  scheduledFor   DateTime
  sentAt         DateTime?
  status         JobStatus    @default(PENDING)
  errorMessage   String?
  bullmqJobId    String?      @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, scheduledFor])
  @@index([recipientEmail])
}
